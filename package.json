{
  "name": "mult-console",
  "productName": "Mult Console",
  "version": "1.0.0",
  "description": "Map a single MIDI fader/knob to native plugin parameters on whichever Ableton track is currently selected.",
  "author": "Daniel Fishman",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node bridge/server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "osc": "^2.4.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.fishman.multconsole",
    "productName": "Mult Console",
    "npmRebuild": false,
    "afterPack": "build/afterPack.js",
    "directories": {
      "output": "dist-installers",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "MaxFishman",
      "repo": "mult-console"
    },
    "files": [
      "electron/**/*",
      "bridge/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/AbletonOSC",
        "to": "AbletonOSC"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    }
  }
}
